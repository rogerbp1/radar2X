# ==============================================================================
# 🔑 CREDENCIALES REQUERIDAS PARA OPERACIÓN EN VIVO — 30X HackRadar
# ==============================================================================
# Copia este archivo a .env.local (cp .env.example .env.local) o configúralas
# directamente desde el botón "🔑 CONECTAR APIs" en http://localhost:3000
#
# 1. OPENROUTER_API_KEY: Necesaria para ejecutar TypeSafe Jev (typesafe/jev-1.14
#    en /api/alpha/decisions) y la cascada de modelos LLM :free.
#    Obtener en: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 2. YOUTUBE_API_KEY: Necesaria para buscar videos de los últimos 7 días y
#    calcular la velocidad real (vistas / horas desde publicación).
#    Obtener en: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# 3. TAVILY_API_KEY: Necesaria para descubrir publicaciones públicas virales
#    indexadas en LinkedIn, TikTok e Instagram sin scraping ilegal.
#    Obtener en: https://app.tavily.com/home
TAVILY_API_KEY=
